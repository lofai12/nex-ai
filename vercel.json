@'
{
  "version": 2,
  "buildCommand": "cd chatbot-frontend && npm install && npm run build",
  "outputDirectory": "chatbot-frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
'@ | Set-Content ".\vercel.json"